<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <IncludeWindowsSDKRefFrameworkReferences>false</IncludeWindowsSDKRefFrameworkReferences>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\assets\PicRope.ico</ApplicationIcon>
    <AssemblyName>PicRopeCapture</AssemblyName>
    <RootNamespace>SnipLite</RootNamespace>
    <Version>1.0.0</Version>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Localization/Resources/*.json" LogicalName="SnipLite.Localization.%(Filename).json" />
    <EmbeddedResource Include="Assets/PaperFold.wav" LogicalName="SnipLite.PaperFold.wav" />
    <EmbeddedResource Include="..\assets\PicRope.ico" LogicalName="SnipLite.AppIcon.ico" />
    <PackageReference Include="Sdcb.SimdPaddleOCR" Version="2.0.0" />
    <PackageReference Include="Sdcb.SimdPaddleOCR.Models.ChineseV6Small" Version="1.0.0" />
    <PackageReference Include="ZXing.Net.Bindings.Windows.Compatibility" Version="0.16.17" />
    <PackageReference Include="Interop.UIAutomationClient" Version="10.19041.0" />
    <None Update="Legal\**\*" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
